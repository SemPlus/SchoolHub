rules_version = '2';

// Everything in SchoolHub is public to read (materials, folders, requests and
// single profiles). Writes are tightly scoped, and every number that feeds a
// rank (opens, saves, accepted answers, verifications) can only change in
// ways a single honest user could cause.

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================== helpers

    function isAuthenticated() {
      return request.auth != null;
    }

    function userPath(id) {
      return /databases/$(database)/documents/users/$(id);
    }

    function materialPath(id) {
      return /databases/$(database)/documents/materials/$(id);
    }

    function collectionPath(id) {
      return /databases/$(database)/documents/collections/$(id);
    }

    // A material may point at a collection only if that collection exists.
    function isValidCollectionLink(data) {
      return !('collectionId' in data) || data.collectionId == null ||
        (data.collectionId is string && data.collectionId.size() <= 128 && exists(collectionPath(data.collectionId)));
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        (request.auth.token.email == "sem.gk01@gmail.com" ||
          (exists(userPath(request.auth.uid)) && get(userPath(request.auth.uid)).data.role == 'admin'));
    }

    function isTeacher() {
      return isAuthenticated() &&
        exists(userPath(request.auth.uid)) &&
        get(userPath(request.auth.uid)).data.role == 'teacher';
    }

    function isValidUrl(url) {
      return url is string && url.matches('^(https?|data):.*');
    }

    function optString(data, key, max) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= max);
    }

    function optInt(data, key, min, max) {
      return !(key in data) || data[key] == null || (data[key] is int && data[key] >= min && data[key] <= max);
    }

    function optTimestamp(data, key) {
      return !(key in data) || data[key] == null || data[key] is timestamp;
    }

    function optBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    function optSection(data) {
      return !('classSection' in data) || data.classSection == null ||
        (data.classSection is string && data.classSection.matches('^[A-Z]{1,3}$'));
    }

    // ============================================================ validators

    function isValidMaterialData(data) {
      return data.keys().hasAll(['title', 'type', 'url', 'authorId', 'authorName', 'downloadCount', 'createdAt']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        optString(data, 'description', 2000) &&
        data.type in ['pdf', 'word', 'canva', 'link', 'drive', 'other'] &&
        isValidUrl(data.url) && data.url.size() <= 1000000 &&
        data.authorId is string && data.authorId.size() > 0 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        optString(data, 'authorPhotoUrl', 1000) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
        data.downloadCount is int && data.downloadCount >= 0 &&
        optInt(data, 'saveCount', 0, 100000000) &&
        optString(data, 'folderId', 128) &&
        data.createdAt is timestamp &&
        optTimestamp(data, 'updatedAt') &&
        optBool(data, 'isDeleted') &&
        optTimestamp(data, 'deletedAt') &&
        optString(data, 'schoolId', 16) &&
        optString(data, 'schoolName', 200) &&
        optString(data, 'schoolCity', 100) &&
        optString(data, 'classId', 64) &&
        optString(data, 'className', 10) &&
        optInt(data, 'classYear', 1, 5) &&
        optSection(data) &&
        optString(data, 'subject', 40) &&
        optTimestamp(data, 'examDate') &&
        optString(data, 'verifiedBy', 128) &&
        optString(data, 'verifiedByName', 100) &&
        optTimestamp(data, 'verifiedAt') &&
        (!('linkStatus' in data) || data.linkStatus == null || data.linkStatus in ['ok', 'broken', 'restricted']) &&
        optTimestamp(data, 'linkCheckedAt') &&
        optTimestamp(data, 'visibleInArchiveUntil') &&
        optString(data, 'collectionId', 128) &&
        optString(data, 'kind', 30) &&
        optString(data, 'level', 20) &&
        optString(data, 'improvesId', 128) &&
        (!('isbn' in data) || data.isbn == null || (data.isbn is string && data.isbn.matches('^97[89][0-9]{10}$'))) &&
        optString(data, 'bookTitle', 200) &&
        // Word prefixes for search (lib/search.ts).
        (!('keywords' in data) || data.keywords == null || (data.keywords is list && data.keywords.size() <= 300));
    }

    function isValidFolderData(data) {
      return data.keys().hasAll(['name', 'authorId', 'authorName', 'isPublic', 'createdAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.authorId is string && data.authorId.size() > 0 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        optString(data, 'parentId', 128) &&
        data.isPublic is bool &&
        data.createdAt is timestamp &&
        optTimestamp(data, 'updatedAt') &&
        optBool(data, 'isDeleted') &&
        optTimestamp(data, 'deletedAt') &&
        optString(data, 'schoolId', 16) &&
        optString(data, 'schoolName', 200) &&
        optString(data, 'classId', 64) &&
        optString(data, 'className', 10);
    }

    function isValidUserData(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.uid is string &&
        (data.email == null || data.email is string) &&
        optString(data, 'displayName', 100) &&
        optString(data, 'photoURL', 1000) &&
        optString(data, 'customColor', 20) &&
        optString(data, 'customBadge', 40) &&
        (!('unlockedBadges' in data) || data.unlockedBadges is list) &&
        data.role in ['admin', 'teacher', 'user'] &&
        data.createdAt is timestamp &&
        optString(data, 'schoolId', 16) &&
        optString(data, 'schoolName', 200) &&
        optString(data, 'schoolCity', 100) &&
        optInt(data, 'schoolGrade', 1, 2) &&
        optInt(data, 'classYear', 1, 5) &&
        optSection(data) &&
        optInt(data, 'profileSchoolYear', 2000, 2100) &&
        (!('accountType' in data) || data.accountType == null || data.accountType in ['student', 'teacher']) &&
        (!('teacherClasses' in data) || data.teacherClasses == null || (data.teacherClasses is list && data.teacherClasses.size() <= 30)) &&
        (!('teacherSubjects' in data) || data.teacherSubjects == null || (data.teacherSubjects is list && data.teacherSubjects.size() <= 30));
    }

    function isValidCollectionData(data) {
      return data.keys().hasAll(['title', 'createdBy', 'createdByName', 'createdAt']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        optString(data, 'description', 1000) &&
        optString(data, 'subject', 40) &&
        optString(data, 'schoolId', 16) &&
        optString(data, 'schoolName', 200) &&
        optInt(data, 'classYear', 1, 5) &&
        optSection(data) &&
        optString(data, 'className', 10) &&
        optString(data, 'classId', 64) &&
        data.createdBy is string &&
        data.createdByName is string && data.createdByName.size() <= 100 &&
        data.createdAt is timestamp &&
        optTimestamp(data, 'updatedAt') &&
        optBool(data, 'isDeleted') &&
        optBool(data, 'isHandIn') &&
        optTimestamp(data, 'dueAt') &&
        optString(data, 'winnerMaterialId', 128) &&
        optString(data, 'winnerAuthorId', 128) &&
        optString(data, 'winnerAuthorName', 100);
    }

    // Hand-in deadlines are a teacher feature.
    function canSetDeadline(data) {
      return data.get('dueAt', null) == null ||
        (exists(userPath(request.auth.uid)) &&
          (get(userPath(request.auth.uid)).data.get('accountType', '') == 'teacher' ||
           get(userPath(request.auth.uid)).data.role in ['teacher', 'admin'] ||
           isAdmin()));
    }

    function isValidRequestData(data) {
      return data.keys().hasAll(['title', 'authorId', 'authorName', 'status', 'createdAt']) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
        optString(data, 'details', 1000) &&
        optString(data, 'subject', 40) &&
        data.authorId is string &&
        data.authorName is string && data.authorName.size() <= 100 &&
        optString(data, 'schoolId', 16) &&
        optString(data, 'schoolName', 200) &&
        optInt(data, 'classYear', 1, 5) &&
        optSection(data) &&
        optString(data, 'className', 10) &&
        data.status in ['open', 'fulfilled', 'closed'] &&
        data.createdAt is timestamp;
    }

    // ============================================================= materials

    match /materials/{materialId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        isValidMaterialData(request.resource.data) &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.downloadCount == 0 &&
        request.resource.data.get('saveCount', 0) == 0 &&
        request.resource.data.get('verifiedBy', null) == null &&
        request.resource.data.get('linkStatus', null) == null &&
        isValidCollectionLink(request.resource.data) &&
        request.resource.data.createdAt == request.time;

      function materialChanged() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function isAuthorOrAdmin() {
        return isAuthenticated() && (request.auth.uid == resource.data.authorId || isAdmin());
      }

      // Author edits. Counters cannot be touched; verification can only be
      // cleared, and must be cleared when the link changes.
      function isAuthorEdit() {
        return isAuthorOrAdmin() &&
          isValidMaterialData(request.resource.data) &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          !materialChanged().hasAny(['downloadCount', 'saveCount', 'linkCheckedAt']) &&
          (!materialChanged().hasAny(['verifiedBy', 'verifiedByName', 'verifiedAt']) ||
            request.resource.data.get('verifiedBy', null) == null) &&
          (!materialChanged().hasAny(['url']) || request.resource.data.get('verifiedBy', null) == null) &&
          (!materialChanged().hasAny(['linkStatus']) || request.resource.data.linkStatus == null) &&
          (!materialChanged().hasAny(['collectionId']) || isValidCollectionLink(request.resource.data));
      }

      function isTrashToggle() {
        return isAuthorOrAdmin() &&
          materialChanged().hasAny(['isDeleted', 'deletedAt']) &&
          materialChanged().hasOnly(['isDeleted', 'deletedAt']) &&
          request.resource.data.isDeleted is bool;
      }

      function openPath() {
        let id = request.auth.uid + '_' + materialId;
        return /databases/$(database)/documents/opens/$(id);
      }

      // +1 only together with creating this user's first open record.
      function isOpenCount() {
        return isAuthenticated() &&
          request.auth.uid != resource.data.authorId &&
          materialChanged().hasOnly(['downloadCount']) &&
          request.resource.data.downloadCount == resource.data.downloadCount + 1 &&
          !exists(openPath()) &&
          existsAfter(openPath());
      }

      function savePath() {
        let id = request.auth.uid + '_' + materialId;
        return /databases/$(database)/documents/saves/$(id);
      }

      // +1 with creating a counted save, -1 with deleting one.
      function isSaveCount() {
        let before = resource.data.get('saveCount', 0);
        let after = request.resource.data.get('saveCount', 0);
        return isAuthenticated() &&
          request.auth.uid != resource.data.authorId &&
          materialChanged().hasOnly(['saveCount']) &&
          ((after == before + 1 && !exists(savePath()) && existsAfter(savePath()) &&
              getAfter(savePath()).data.get('counted', false) == true) ||
           (after == before - 1 && before > 0 && exists(savePath()) && !existsAfter(savePath()) &&
              get(savePath()).data.get('counted', false) == true));
      }

      // Teachers verify materials of their own school; admins any material.
      // Nobody verifies their own upload.
      function isVerification() {
        return isAuthenticated() &&
          request.auth.uid != resource.data.authorId &&
          materialChanged().hasOnly(['verifiedBy', 'verifiedByName', 'verifiedAt']) &&
          (isAdmin() ||
            (isTeacher() && get(userPath(request.auth.uid)).data.get('schoolId', '') == resource.data.get('schoolId', 'none'))) &&
          ((request.resource.data.verifiedBy == request.auth.uid &&
              request.resource.data.verifiedByName is string &&
              request.resource.data.verifiedByName.size() <= 100 &&
              request.resource.data.verifiedAt == request.time) ||
           (request.resource.data.verifiedBy == null &&
              request.resource.data.verifiedByName == null &&
              request.resource.data.verifiedAt == null));
      }

      allow update: if isAuthorEdit() || isTrashToggle() || isOpenCount() || isSaveCount() || isVerification();

      allow delete: if isAuthorOrAdmin();

      // Stars and a comment from one person on one work (id = their uid).
      // Authors cannot review their own work.
      match /feedback/{userId} {
        allow read: if true;

        function isValidFeedback(data) {
          return (!('rating' in data) || data.rating == null || (data.rating is int && data.rating >= 1 && data.rating <= 5)) &&
            (!('comment' in data) || data.comment == null || (data.comment is string && data.comment.size() <= 500)) &&
            (data.get('rating', null) != null || data.get('comment', null) != null);
        }

        allow create: if isAuthenticated() &&
          userId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['userId', 'userName', 'rating', 'comment', 'createdAt']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.userName is string && request.resource.data.userName.size() <= 100 &&
          request.resource.data.createdAt == request.time &&
          isValidFeedback(request.resource.data) &&
          get(materialPath(materialId)).data.authorId != request.auth.uid;

        allow update: if isAuthenticated() &&
          userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']) &&
          request.resource.data.updatedAt == request.time &&
          isValidFeedback(request.resource.data);

        allow delete: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
      }
    }

    // ================================================================= opens

    // One record per user and material: {uid}_{materialId}.
    match /opens/{openId} {
      // The founder reads all opens for the dashboard's activity charts.
      allow get: if isAuthenticated() && (openId.matches(request.auth.uid + '_.*') || isAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['userId', 'materialId', 'createdAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.materialId is string &&
        openId == request.auth.uid + '_' + request.resource.data.materialId &&
        request.resource.data.createdAt == request.time &&
        getAfter(materialPath(request.resource.data.materialId)).data.downloadCount ==
          get(materialPath(request.resource.data.materialId)).data.downloadCount + 1;

      allow update, delete: if false;
    }

    // ================================================================= saves

    match /saves/{saveId} {
      allow get: if isAuthenticated() && (saveId.matches(request.auth.uid + '_.*') || isAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['userId', 'materialId', 'counted', 'createdAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.materialId is string &&
        saveId == request.auth.uid + '_' + request.resource.data.materialId &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.counted ==
          (get(materialPath(request.resource.data.materialId)).data.authorId != request.auth.uid) &&
        (request.resource.data.counted == false ||
          getAfter(materialPath(request.resource.data.materialId)).data.get('saveCount', 0) ==
            get(materialPath(request.resource.data.materialId)).data.get('saveCount', 0) + 1);

      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin()) &&
        (resource.data.get('counted', false) == false ||
          !exists(materialPath(resource.data.materialId)) ||
          getAfter(materialPath(resource.data.materialId)).data.get('saveCount', 0) ==
            get(materialPath(resource.data.materialId)).data.get('saveCount', 0) - 1);
    }

    // =============================================================== folders

    match /folders/{folderId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        isValidFolderData(request.resource.data) &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.createdAt == request.time;

      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.authorId || isAdmin()) && (
          (isValidFolderData(request.resource.data) &&
            request.resource.data.authorId == resource.data.authorId &&
            request.resource.data.createdAt == resource.data.createdAt) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasAny(['isDeleted', 'deletedAt']) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'deletedAt']) &&
            request.resource.data.isDeleted is bool)
        );

      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isAdmin());
    }

    // ============================================================ collections

    // Shared themes or projects. Anyone signed in can start one and add their
    // own works to it; the creator (or the founder) can rename or delete it.
    match /collections/{collectionId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        isValidCollectionData(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.get('isDeleted', false) == false &&
        canSetDeadline(request.resource.data);

      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.createdBy || isAdmin()) &&
        isValidCollectionData(request.resource.data) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dueAt']) || canSetDeadline(request.resource.data)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['winnerMaterialId', 'winnerAuthorId', 'winnerAuthorName']) ||
          request.resource.data.get('winnerMaterialId', null) == null ||
          (get(materialPath(request.resource.data.winnerMaterialId)).data.get('collectionId', '') == collectionId &&
           get(materialPath(request.resource.data.winnerMaterialId)).data.authorId == request.resource.data.winnerAuthorId));

      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.createdBy || isAdmin());

      // Best-work vote: one per person (id = their uid), for a work in this
      // collection that is not their own, while no winner is announced.
      match /votes/{userId} {
        allow read: if true;

        function isValidVote() {
          let work = get(materialPath(request.resource.data.materialId)).data;
          return request.resource.data.materialId is string &&
            work.get('collectionId', '') == collectionId &&
            work.authorId != request.auth.uid &&
            get(collectionPath(collectionId)).data.get('winnerMaterialId', null) == null;
        }

        allow create: if isAuthenticated() &&
          userId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['userId', 'materialId', 'createdAt']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          isValidVote();

        allow update: if isAuthenticated() &&
          userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['materialId']) &&
          isValidVote();

        allow delete: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
      }
    }

    // ================================================================= users

    match /users/{userId} {
      // Single profiles are public (author cards read them). Listing the whole
      // collection would expose every e-mail address, so only admins may list.
      allow get: if true;
      allow list: if isAdmin();

      allow create: if isAuthenticated() &&
        userId == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        isValidUserData(request.resource.data) &&
        (request.resource.data.role == 'user' || (request.resource.data.role == 'admin' && isAdmin()));

      allow update: if
        // Own profile: anything valid except the role.
        (isAuthenticated() &&
          userId == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          isValidUserData(request.resource.data) &&
          request.resource.data.role == resource.data.role) ||
        // Admin grants or removes the teacher role, and nothing else.
        (isAdmin() &&
          userId != request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
          request.resource.data.role in ['user', 'teacher'] &&
          resource.data.role in ['user', 'teacher']);

      allow delete: if isAdmin();

      // Materials this user marked as studied. Private to the user.
      match /studied/{materialId} {
        allow read, delete: if isAuthenticated() && request.auth.uid == userId;
        allow create, update: if isAuthenticated() &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['createdAt']) &&
          request.resource.data.createdAt == request.time;
      }
    }

    // ============================================================== requests

    match /requests/{requestId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        isValidRequestData(request.resource.data) &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt == request.time &&
        !('acceptedUserId' in request.resource.data);

      function requestChanged() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function isRequester() {
        return isAuthenticated() && request.auth.uid == resource.data.authorId;
      }

      function answerPath(id) {
        return /databases/$(database)/documents/requests/$(requestId)/answers/$(id);
      }

      allow update: if isRequester() && isValidRequestData(request.resource.data) && (
        // Close or reopen
        (requestChanged().hasOnly(['status']) &&
          ((resource.data.status == 'open' && request.resource.data.status == 'closed') ||
           (resource.data.status == 'closed' && request.resource.data.status == 'open'))) ||
        // Accept an existing answer from someone else
        (resource.data.status == 'open' &&
          request.resource.data.status == 'fulfilled' &&
          requestChanged().hasOnly(['status', 'acceptedAnswerId', 'acceptedUserId', 'acceptedUserName', 'acceptedMaterialId', 'fulfilledAt']) &&
          exists(answerPath(request.resource.data.acceptedAnswerId)) &&
          get(answerPath(request.resource.data.acceptedAnswerId)).data.userId == request.resource.data.acceptedUserId &&
          get(answerPath(request.resource.data.acceptedAnswerId)).data.materialId == request.resource.data.acceptedMaterialId &&
          request.resource.data.acceptedUserId != request.auth.uid &&
          request.resource.data.acceptedUserName is string &&
          request.resource.data.acceptedUserName.size() <= 100 &&
          request.resource.data.fulfilledAt == request.time)
      );

      // A fulfilled request is part of the helper's record, so only an admin
      // can remove it.
      allow delete: if (isRequester() && resource.data.status != 'fulfilled') || isAdmin();

      // One answer per user: the document id is the answering user's uid.
      match /answers/{answerId} {
        allow read: if true;

        allow create: if isAuthenticated() &&
          answerId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['userId', 'userName', 'materialId', 'materialTitle', 'createdAt']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.userName is string && request.resource.data.userName.size() <= 100 &&
          request.resource.data.materialId is string &&
          request.resource.data.materialTitle is string && request.resource.data.materialTitle.size() <= 200 &&
          request.resource.data.createdAt == request.time &&
          get(materialPath(request.resource.data.materialId)).data.authorId == request.auth.uid &&
          get(/databases/$(database)/documents/requests/$(requestId)).data.status == 'open' &&
          get(/databases/$(database)/documents/requests/$(requestId)).data.authorId != request.auth.uid;

        allow delete: if isAuthenticated() && (
          request.auth.uid == resource.data.userId ||
          request.auth.uid == get(/databases/$(database)/documents/requests/$(requestId)).data.authorId ||
          isAdmin());
      }
    }
  }
}
