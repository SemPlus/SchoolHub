rules_version = '2';

// Everything in SchoolHub is public to read (materials, folders, requests and
// single profiles). Writes are tightly scoped, and every number that feeds a
// rank (opens, saves, accepted answers, verifications) can only change in
// ways a single honest user could cause.

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================== helpers

    function isAuthenticated() {
      return request.auth != null;
    }

    function userPath(id) {
      return /databases/$(database)/documents/users/$(id);
    }

    function materialPath(id) {
      return /databases/$(database)/documents/materials/$(id);
    }

    function collectionPath(id) {
      return /databases/$(database)/documents/collections/$(id);
    }

    // A material may point at a collection only if that collection exists.
    function isValidCollectionLink(data) {
      return !('collectionId' in data) || data.collectionId == null ||
        (data.collectionId is string && data.collectionId.size() <= 128 && exists(collectionPath(data.collectionId)));
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        (request.auth.token.email == "sem.gk01@gmail.com" ||
          (exists(userPath(request.auth.uid)) && get(userPath(request.auth.uid)).data.role == 'admin'));
    }

    function isTeacher() {
      return isAuthenticated() &&
        exists(userPath(request.auth.uid)) &&
        get(userPath(request.auth.uid)).data.role == 'teacher';
    }

    // School admins (principal, vice-principal, digital lead): named by the
    // founder in schoolAdmins/{e-mail}, for one school, while it is activated.
    function schoolAdminPath() {
      return /databases/$(database)/documents/schoolAdmins/$(request.auth.token.email.lower());
    }

    function isSchoolAdmin() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        exists(schoolAdminPath()) &&
        get(/databases/$(database)/documents/schools/$(get(schoolAdminPath()).data.schoolId)).data.activated == true &&
        (get(/databases/$(database)/documents/schools/$(get(schoolAdminPath()).data.schoolId)).data.get('activatedUntil', null) == null ||
         get(/databases/$(database)/documents/schools/$(get(schoolAdminPath()).data.schoolId)).data.activatedUntil > request.time);
    }

    function isSchoolAdminOf(schoolId) {
      return isSchoolAdmin() && get(schoolAdminPath()).data.schoolId == schoolId;
    }

    // Teachers verified by their school's e-mail (decided 2026-11-21). A
    // teacher sign-up of an active school is confirmed when the Google
    // address is on one of the school's staff domains (schools.teacherDomains,
    // at most 3) or on its list of teachers' e-mails
    // (teacherEmails/{schoolId}_{email}). Both are set in the school panel.
    function schoolPath(id) {
      return /databases/$(database)/documents/schools/$(id);
    }

    function isActiveSchool(id) {
      return exists(schoolPath(id)) &&
        get(schoolPath(id)).data.activated == true &&
        (get(schoolPath(id)).data.get('activatedUntil', null) == null ||
         get(schoolPath(id)).data.activatedUntil > request.time);
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isStaffEmailOf(schoolId) {
      return request.auth.token.email_verified == true &&
        schoolId is string && schoolId != '' &&
        isActiveSchool(schoolId) &&
        (get(schoolPath(schoolId)).data.get('teacherDomains', []).hasAny([myEmail().split('@')[1]]) ||
         exists(/databases/$(database)/documents/teacherEmails/$(schoolId + '_' + myEmail())));
    }

    // A staff domain: lower case, and never a public mail service.
    function isStaffDomain(x) {
      return x is string && x.size() <= 100 &&
        x.matches('^[a-z0-9-]+([.][a-z0-9-]+)*[.][a-z]{2,}$') &&
        !(x in ['gmail.com', 'googlemail.com', 'outlook.com', 'outlook.it', 'hotmail.com', 'hotmail.it',
          'live.com', 'live.it', 'msn.com', 'yahoo.com', 'yahoo.it', 'icloud.com', 'me.com', 'libero.it',
          'virgilio.it', 'alice.it', 'tiscali.it', 'tin.it', 'fastwebnet.it', 'email.it', 'proton.me',
          'protonmail.com', 'pec.it', 'aruba.it']);
    }

    function optStaffDomains(data) {
      let d = data.get('teacherDomains', []);
      return d is list && d.size() <= 3 &&
        (d.size() < 1 || isStaffDomain(d[0])) &&
        (d.size() < 2 || isStaffDomain(d[1])) &&
        (d.size() < 3 || isStaffDomain(d[2]));
    }

    // Reports (see lib/moderation.ts). Content is hidden at the third report
    // from different people, or at once when a teacher reports copyright.
    function reportReasons() {
      return ['copyright', 'offensive', 'personal', 'broken', 'other'];
    }

    function reportPathFor(key) {
      return /databases/$(database)/documents/reports/$(key + '_' + request.auth.uid);
    }

    // +1 to a content's reportCount, only together with creating this user's
    // report on it; the owner cannot report their own content.
    function isReportCount(key, ownerId) {
      let rp = reportPathFor(key);
      let before = resource.data.get('reportCount', 0);
      let after = request.resource.data.get('reportCount', 0);
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAuthenticated() &&
        request.auth.uid != ownerId &&
        resource.data.get('modStatus', null) != 'removed' &&
        changed.hasOnly(['reportCount', 'modStatus', 'modReason']) &&
        after == before + 1 &&
        !exists(rp) && existsAfter(rp) &&
        (!changed.hasAny(['modStatus', 'modReason']) ||
          (resource.data.get('modStatus', null) == null &&
           request.resource.data.modStatus == 'hidden' &&
           request.resource.data.modReason == getAfter(rp).data.reason &&
           (after >= 3 || (getAfter(rp).data.reason == 'copyright' && (isTeacher() || isAdmin())))));
    }

    // A moderator's "Va bene": visible again, reports from zero.
    function isModKeep() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['reportCount', 'modStatus', 'modReason', 'modAt']) &&
        request.resource.data.get('reportCount', 0) == 0 &&
        request.resource.data.get('modStatus', null) == null &&
        request.resource.data.get('modReason', null) == null &&
        (!changed.hasAny(['modAt']) || request.resource.data.modAt == request.time);
    }

    function isValidUrl(url) {
      return url is string && url.matches('^(https?|data):.*');
    }

    function optString(data, key, max) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= max);
    }

    function optInt(data, key, min, max) {
      return !(key in data) || data[key] == null || (data[key] is int && data[key] >= min && data[key] <= max);
    }

    function optTimestamp(data, key) {
      return !(key in data) || data[key] == null || data[key] is timestamp;
    }

    function optBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    function optSection(data) {
      return !('classSection' in data) || data.classSection == null ||
        (data.classSection is string && data.classSection.matches('^[A-Z]{1,3}$'));
    }

    // ============================================================ validators

    function isValidMaterialData(data) {
      return data.keys().hasAll(['title', 'type', 'url', 'authorId', 'authorName', 'downloadCount', 'createdAt']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        optString(data, 'description', 2000) &&
        data.type in ['pdf', 'word', 'canva', 'link', 'drive', 'other'] &&
        isValidUrl(data.url) && data.url.size() <= 1000000 &&
        data.authorId is string && data.authorId.size() > 0 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        optString(data, 'authorPhotoUrl', 1000) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
        data.downloadCount is int && data.downloadCount >= 0 &&
        optInt(data, 'saveCount', 0, 100000000) &&
        optString(data, 'folderId', 128) &&
        data.createdAt is timestamp &&
        optTimestamp(data, 'updatedAt') &&
        optBool(data, 'isDeleted') &&
        optTimestamp(data, 'deletedAt') &&
        optString(data, 'schoolId', 16) &&
        optString(data, 'schoolName', 200) &&
        optString(data, 'schoolCity', 100) &&
        optString(data, 'classId', 64) &&
        optString(data, 'className', 10) &&
        optInt(data, 'classYear', 1, 5) &&
        optSection(data) &&
        optString(data, 'subject', 40) &&
        optTimestamp(data, 'examDate') &&
        optString(data, 'verifiedBy', 128) &&
        optString(data, 'verifiedByName', 100) &&
        optTimestamp(data, 'verifiedAt') &&
        (!('linkStatus' in data) || data.linkStatus == null || data.linkStatus in ['ok', 'broken', 'restricted']) &&
        optTimestamp(data, 'linkCheckedAt') &&
        optTimestamp(data, 'visibleInArchiveUntil') &&
        optString(data, 'collectionId', 128) &&
        optString(data, 'kind', 30) &&
        optString(data, 'level', 20) &&
        optString(data, 'improvesId', 128) &&
        (!('isbn' in data) || data.isbn == null || (data.isbn is string && data.isbn.matches('^97[89][0-9]{10}$'))) &&
        optString(data, 'bookTitle', 200) &&
        (!('coAuthorIds' in data) || data.coAuthorIds == null || (data.coAuthorIds is list && data.coAuthorIds.size() <= 5)) &&
        (!('coAuthorNames' in data) || data.coAuthorNames == null || (data.coAuthorNames is list && data.coAuthorNames.size() <= 5)) &&
        // Word prefixes for search (lib/search.ts).
        (!('keywords' in data) || data.keywords == null || (data.keywords is list && data.keywords.size() <= 300));
    }

    function isValidFolderData(data) {
      return data.keys().hasAll(['name', 'authorId', 'authorName', 'isPublic', 'createdAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.authorId is string && data.authorId.size() > 0 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        optString(data, 'parentId', 128) &&
        data.isPublic is bool &&
        data.createdAt is timestamp &&
        optTimestamp(data, 'updatedAt') &&
        optBool(data, 'isDeleted') &&
        optTimestamp(data, 'deletedAt') &&
        optString(data, 'schoolId', 16) &&
        optString(data, 'schoolName', 200) &&
        optString(data, 'classId', 64) &&
        optString(data, 'className', 10);
    }

    function isValidUserData(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.uid is string &&
        (data.email == null || data.email is string) &&
        optString(data, 'displayName', 100) &&
        optString(data, 'photoURL', 1000) &&
        optString(data, 'customColor', 20) &&
        optString(data, 'customBadge', 40) &&
        (!('unlockedBadges' in data) || data.unlockedBadges is list) &&
        data.role in ['admin', 'teacher', 'user'] &&
        data.createdAt is timestamp &&
        optString(data, 'schoolId', 16) &&
        optString(data, 'schoolName', 200) &&
        optString(data, 'schoolCity', 100) &&
        optInt(data, 'schoolGrade', 1, 2) &&
        optInt(data, 'classYear', 1, 5) &&
        optSection(data) &&
        optInt(data, 'profileSchoolYear', 2000, 2100) &&
        (!('accountType' in data) || data.accountType == null || data.accountType in ['student', 'teacher']) &&
        (!('teacherClasses' in data) || data.teacherClasses == null || (data.teacherClasses is list && data.teacherClasses.size() <= 30)) &&
        (!('teacherSubjects' in data) || data.teacherSubjects == null || (data.teacherSubjects is list && data.teacherSubjects.size() <= 30));
    }

    function isValidCollectionData(data) {
      return data.keys().hasAll(['title', 'createdBy', 'createdByName', 'createdAt']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        optString(data, 'description', 1000) &&
        optString(data, 'subject', 40) &&
        optString(data, 'schoolId', 16) &&
        optString(data, 'schoolName', 200) &&
        optInt(data, 'classYear', 1, 5) &&
        optSection(data) &&
        optString(data, 'className', 10) &&
        optString(data, 'classId', 64) &&
        data.createdBy is string &&
        data.createdByName is string && data.createdByName.size() <= 100 &&
        data.createdAt is timestamp &&
        optTimestamp(data, 'updatedAt') &&
        optBool(data, 'isDeleted') &&
        optBool(data, 'isHandIn') &&
        optTimestamp(data, 'dueAt') &&
        optString(data, 'winnerMaterialId', 128) &&
        optString(data, 'winnerAuthorId', 128) &&
        optString(data, 'winnerAuthorName', 100) &&
        optBool(data, 'isLot') &&
        (!('lotType' in data) || data.lotType == null || data.lotType in ['same', 'different']) &&
        optString(data, 'themeId', 128) &&
        optTimestamp(data, 'closedAt') &&
        (!('removedMaterialIds' in data) || data.removedMaterialIds == null ||
          (data.removedMaterialIds is list && data.removedMaterialIds.size() <= 200));
    }

    // Teacher account: self-chosen at sign-up, or the role granted by the founder.
    function isTeacherUser() {
      return exists(userPath(request.auth.uid)) &&
        (get(userPath(request.auth.uid)).data.get('accountType', '') == 'teacher' ||
         get(userPath(request.auth.uid)).data.role in ['teacher', 'admin'] ||
         isAdmin());
    }

    // Hand-in deadlines are a teacher feature.
    function canSetDeadline(data) {
      return data.get('dueAt', null) == null ||
        (exists(userPath(request.auth.uid)) &&
          (get(userPath(request.auth.uid)).data.get('accountType', '') == 'teacher' ||
           get(userPath(request.auth.uid)).data.role in ['teacher', 'admin'] ||
           isAdmin()));
    }

    function isValidRequestData(data) {
      return data.keys().hasAll(['title', 'authorId', 'authorName', 'status', 'createdAt']) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
        optString(data, 'details', 1000) &&
        optString(data, 'subject', 40) &&
        data.authorId is string &&
        data.authorName is string && data.authorName.size() <= 100 &&
        optString(data, 'schoolId', 16) &&
        optString(data, 'schoolName', 200) &&
        optInt(data, 'classYear', 1, 5) &&
        optSection(data) &&
        optString(data, 'className', 10) &&
        data.status in ['open', 'fulfilled', 'closed'] &&
        data.createdAt is timestamp;
    }

    // ============================================================= materials

    match /materials/{materialId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        isValidMaterialData(request.resource.data) &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.downloadCount == 0 &&
        request.resource.data.get('saveCount', 0) == 0 &&
        request.resource.data.get('verifiedBy', null) == null &&
        request.resource.data.get('linkStatus', null) == null &&
        isValidCollectionLink(request.resource.data) &&
        !request.resource.data.keys().hasAny(['reportCount', 'modStatus', 'modReason', 'modAt', 'modFixedAt']) &&
        // "I can share it: it is my own work or free material."
        request.resource.data.get('rightsConfirmed', false) == true &&
        request.resource.data.createdAt == request.time;

      function materialChanged() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function isAuthorOrAdmin() {
        return isAuthenticated() && (request.auth.uid == resource.data.authorId || isAdmin());
      }

      // Author edits. Counters cannot be touched; verification can only be
      // cleared, and must be cleared when the link changes.
      function isAuthorEdit() {
        return isAuthorOrAdmin() &&
          isValidMaterialData(request.resource.data) &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          !materialChanged().hasAny(['downloadCount', 'saveCount', 'linkCheckedAt']) &&
          (!materialChanged().hasAny(['verifiedBy', 'verifiedByName', 'verifiedAt']) ||
            request.resource.data.get('verifiedBy', null) == null) &&
          (!materialChanged().hasAny(['url']) || request.resource.data.get('verifiedBy', null) == null) &&
          (!materialChanged().hasAny(['linkStatus']) || request.resource.data.linkStatus == null) &&
          (!materialChanged().hasAny(['collectionId']) || isValidCollectionLink(request.resource.data)) &&
          !materialChanged().hasAny(['reportCount', 'modStatus', 'modReason', 'modAt', 'rightsConfirmed']) &&
          (!materialChanged().hasAny(['modFixedAt']) || request.resource.data.modFixedAt == request.time);
      }

      function isTrashToggle() {
        return isAuthorOrAdmin() &&
          materialChanged().hasAny(['isDeleted', 'deletedAt']) &&
          materialChanged().hasOnly(['isDeleted', 'deletedAt']) &&
          request.resource.data.isDeleted is bool;
      }

      function openPath() {
        let id = request.auth.uid + '_' + materialId;
        return /databases/$(database)/documents/opens/$(id);
      }

      // +1 only together with creating this user's first open record.
      function isOpenCount() {
        return isAuthenticated() &&
          request.auth.uid != resource.data.authorId &&
          materialChanged().hasOnly(['downloadCount']) &&
          request.resource.data.downloadCount == resource.data.downloadCount + 1 &&
          !exists(openPath()) &&
          existsAfter(openPath());
      }

      function savePath() {
        let id = request.auth.uid + '_' + materialId;
        return /databases/$(database)/documents/saves/$(id);
      }

      // +1 with creating a counted save, -1 with deleting one.
      function isSaveCount() {
        let before = resource.data.get('saveCount', 0);
        let after = request.resource.data.get('saveCount', 0);
        return isAuthenticated() &&
          request.auth.uid != resource.data.authorId &&
          materialChanged().hasOnly(['saveCount']) &&
          ((after == before + 1 && !exists(savePath()) && existsAfter(savePath()) &&
              getAfter(savePath()).data.get('counted', false) == true) ||
           (after == before - 1 && before > 0 && exists(savePath()) && !existsAfter(savePath()) &&
              get(savePath()).data.get('counted', false) == true));
      }

      // Teachers verify materials of their own school; admins any material.
      // Nobody verifies their own upload.
      function isVerification() {
        return isAuthenticated() &&
          request.auth.uid != resource.data.authorId &&
          materialChanged().hasOnly(['verifiedBy', 'verifiedByName', 'verifiedAt']) &&
          (isAdmin() ||
            (isTeacher() && get(userPath(request.auth.uid)).data.get('schoolId', '') == resource.data.get('schoolId', 'none'))) &&
          ((request.resource.data.verifiedBy == request.auth.uid &&
              request.resource.data.verifiedByName is string &&
              request.resource.data.verifiedByName.size() <= 100 &&
              request.resource.data.verifiedAt == request.time) ||
           (request.resource.data.verifiedBy == null &&
              request.resource.data.verifiedByName == null &&
              request.resource.data.verifiedAt == null));
      }

      // The school's admins (or the founder) keep or remove reported works.
      function isModeration() {
        return (isAdmin() || isSchoolAdminOf(resource.data.get('schoolId', ''))) &&
          (isModKeep() ||
           (materialChanged().hasOnly(['modStatus', 'modReason', 'modAt']) &&
            request.resource.data.modStatus == 'removed' &&
            request.resource.data.modReason in reportReasons() &&
            request.resource.data.modAt == request.time));
      }

      allow update: if isAuthorEdit() || isTrashToggle() || isOpenCount() || isSaveCount() || isVerification() ||
        isReportCount('m_' + materialId, resource.data.authorId) || isModeration();

      allow delete: if isAuthorOrAdmin();

      // Stars and a comment from one person on one work (id = their uid).
      // Authors cannot review their own work.
      match /feedback/{userId} {
        allow read: if true;

        function isValidFeedback(data) {
          return (!('rating' in data) || data.rating == null || (data.rating is int && data.rating >= 1 && data.rating <= 5)) &&
            (!('comment' in data) || data.comment == null || (data.comment is string && data.comment.size() <= 500)) &&
            (data.get('rating', null) != null || data.get('comment', null) != null);
        }

        allow create: if isAuthenticated() &&
          userId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['userId', 'userName', 'rating', 'comment', 'createdAt']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.userName is string && request.resource.data.userName.size() <= 100 &&
          request.resource.data.createdAt == request.time &&
          isValidFeedback(request.resource.data) &&
          get(materialPath(materialId)).data.authorId != request.auth.uid;

        allow update: if isAuthenticated() &&
          userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']) &&
          request.resource.data.updatedAt == request.time &&
          isValidFeedback(request.resource.data);

        function isWorkModerator() {
          return isAdmin() || isSchoolAdminOf(get(materialPath(materialId)).data.get('schoolId', ''));
        }

        allow update: if isReportCount('c_' + materialId + '_' + userId, userId) || (isWorkModerator() && isModKeep());

        allow delete: if isAuthenticated() && (userId == request.auth.uid || isWorkModerator());
      }
    }

    // ================================================================= opens

    // One record per user and material: {uid}_{materialId}.
    match /opens/{openId} {
      // The founder reads all opens for the dashboard's activity charts.
      allow get: if isAuthenticated() && (openId.matches(request.auth.uid + '_.*') || isAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['userId', 'materialId', 'createdAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.materialId is string &&
        openId == request.auth.uid + '_' + request.resource.data.materialId &&
        request.resource.data.createdAt == request.time &&
        getAfter(materialPath(request.resource.data.materialId)).data.downloadCount ==
          get(materialPath(request.resource.data.materialId)).data.downloadCount + 1;

      allow update, delete: if false;
    }

    // ================================================================= saves

    match /saves/{saveId} {
      allow get: if isAuthenticated() && (saveId.matches(request.auth.uid + '_.*') || isAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['userId', 'materialId', 'counted', 'createdAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.materialId is string &&
        saveId == request.auth.uid + '_' + request.resource.data.materialId &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.counted ==
          (get(materialPath(request.resource.data.materialId)).data.authorId != request.auth.uid) &&
        (request.resource.data.counted == false ||
          getAfter(materialPath(request.resource.data.materialId)).data.get('saveCount', 0) ==
            get(materialPath(request.resource.data.materialId)).data.get('saveCount', 0) + 1);

      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin()) &&
        (resource.data.get('counted', false) == false ||
          !exists(materialPath(resource.data.materialId)) ||
          getAfter(materialPath(resource.data.materialId)).data.get('saveCount', 0) ==
            get(materialPath(resource.data.materialId)).data.get('saveCount', 0) - 1);
    }

    // =============================================================== folders

    match /folders/{folderId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        isValidFolderData(request.resource.data) &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.createdAt == request.time;

      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.authorId || isAdmin()) && (
          (isValidFolderData(request.resource.data) &&
            request.resource.data.authorId == resource.data.authorId &&
            request.resource.data.createdAt == resource.data.createdAt) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasAny(['isDeleted', 'deletedAt']) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'deletedAt']) &&
            request.resource.data.isDeleted is bool)
        );

      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isAdmin());
    }

    // ============================================================ collections

    // Shared themes or projects. Anyone signed in can start one and add their
    // own works to it; the creator (or the founder) can rename or delete it.
    match /collections/{collectionId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        isValidCollectionData(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.get('isDeleted', false) == false &&
        canSetDeadline(request.resource.data) &&
        // Lots (the teacher chooses the best work) are a teacher feature.
        (request.resource.data.get('isLot', false) == false || isTeacherUser());

      allow update: if isAuthenticated() &&
        (request.auth.uid == resource.data.createdBy || isAdmin()) &&
        isValidCollectionData(request.resource.data) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.get('isLot', false) == resource.data.get('isLot', false) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dueAt']) || canSetDeadline(request.resource.data)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['winnerMaterialId', 'winnerAuthorId', 'winnerAuthorName']) ||
          request.resource.data.get('winnerMaterialId', null) == null ||
          (get(materialPath(request.resource.data.winnerMaterialId)).data.get('collectionId', '') == collectionId &&
           get(materialPath(request.resource.data.winnerMaterialId)).data.authorId == request.resource.data.winnerAuthorId));

      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.createdBy || isAdmin());

      // Best-work vote: one per person (id = their uid), for a work in this
      // collection that is not their own, while no winner is announced.
      match /votes/{userId} {
        allow read: if true;

        function isValidVote() {
          let work = get(materialPath(request.resource.data.materialId)).data;
          return request.resource.data.materialId is string &&
            work.get('collectionId', '') == collectionId &&
            work.authorId != request.auth.uid &&
            !(request.auth.uid in work.get('coAuthorIds', [])) &&
            get(collectionPath(collectionId)).data.get('winnerMaterialId', null) == null &&
            get(collectionPath(collectionId)).data.get('closedAt', null) == null;
        }

        allow create: if isAuthenticated() &&
          userId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['userId', 'materialId', 'createdAt']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          isValidVote();

        allow update: if isAuthenticated() &&
          userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['materialId']) &&
          isValidVote();

        allow delete: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
      }
    }

    // ============================================================ directory

    // Class directory, so whoever publishes a group work can add classmates
    // who already have an account. Each person writes only their own entry;
    // only people of the same school can list it (no e-mail addresses here).
    match /directory/{uid} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() &&
        (resource.data.schoolId == get(userPath(request.auth.uid)).data.get('schoolId', '') ||
         isAdmin() || isSchoolAdminOf(resource.data.schoolId));
      allow create, update: if isAuthenticated() && uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'schoolId', 'classYear', 'classSection', 'schoolYear', 'accountType', 'updatedAt']) &&
        request.resource.data.uid == uid &&
        optString(request.resource.data, 'displayName', 100) &&
        optString(request.resource.data, 'photoURL', 1000) &&
        request.resource.data.schoolId is string && request.resource.data.schoolId.size() <= 16 &&
        request.resource.data.schoolId == get(userPath(uid)).data.get('schoolId', '') &&
        optInt(request.resource.data, 'classYear', 1, 5) &&
        optSection(request.resource.data) &&
        optInt(request.resource.data, 'schoolYear', 2000, 2100) &&
        (!('accountType' in request.resource.data) || request.resource.data.accountType == null ||
          request.resource.data.accountType in ['student', 'teacher']) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAuthenticated() && (uid == request.auth.uid || isAdmin());
    }

    // ============================================================== schools

    // Schools activated for classroom mode. Public (the classroom screen
    // checks it without a sign-in); only the founder writes.
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.data.keys().hasOnly(['activated', 'plan', 'name', 'city', 'activatedUntil', 'extraClasses', 'teacherDomains', 'updatedAt']) &&
        optStaffDomains(request.resource.data) &&
        request.resource.data.activated is bool &&
        request.resource.data.plan in ['private', 'partner'] &&
        request.resource.data.name is string && request.resource.data.name.size() <= 200 &&
        optString(request.resource.data, 'city', 100) &&
        optTimestamp(request.resource.data, 'activatedUntil') &&
        (!('extraClasses' in request.resource.data) ||
          (request.resource.data.extraClasses is list && request.resource.data.extraClasses.size() <= 200));
      // The school's admins add classes for the classroom links and set the
      // staff domains, and nothing else.
      allow update: if isSchoolAdminOf(schoolId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['extraClasses', 'teacherDomains', 'updatedAt']) &&
        (!('extraClasses' in request.resource.data) ||
          (request.resource.data.extraClasses is list && request.resource.data.extraClasses.size() <= 200)) &&
        optStaffDomains(request.resource.data) &&
        request.resource.data.updatedAt == request.time;
    }

    // "Last used" per classroom link: the classroom screen has no sign-in, so
    // anyone may stamp the time, but only for an activated school and only
    // with the server time.
    match /aulaVisits/{visitId} {
      allow read: if isAdmin() || isSchoolAdminOf(resource.data.schoolId);
      allow create, update: if
        request.resource.data.keys().hasOnly(['schoolId', 'classLabel', 'lastSeenAt']) &&
        request.resource.data.schoolId is string && request.resource.data.schoolId.size() <= 16 &&
        request.resource.data.classLabel is string && request.resource.data.classLabel.matches('^[1-5][A-Z]{1,3}$') &&
        visitId == request.resource.data.schoolId + '_' + request.resource.data.classLabel &&
        request.resource.data.lastSeenAt == request.time &&
        exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)) &&
        get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.activated == true;
      allow delete: if isAdmin();
    }

    // ========================================================= school panel

    // Who administers which school. Only the founder writes; each admin can
    // read their own entry (to see the School tab); e-mails stay private.
    match /schoolAdmins/{email} {
      allow get: if isAdmin() ||
        (isAuthenticated() && request.auth.token.email_verified == true &&
         request.auth.token.email.lower() == email);
      allow list: if isAdmin();
      allow create, update: if isAdmin() &&
        email.matches('^[^@/ ]+@[^@/ ]+$') &&
        request.resource.data.keys().hasOnly(['schoolId', 'schoolName', 'addedAt']) &&
        request.resource.data.schoolId is string && request.resource.data.schoolId.size() <= 16 &&
        optString(request.resource.data, 'schoolName', 200) &&
        exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId));
      allow delete: if isAdmin();
    }

    // Teachers' e-mails pasted by a school's admins, one entry per address:
    // teacherEmails/{schoolId}_{email}. Private: each person can read only
    // their own entry; the school's admins and the founder see the list.
    match /teacherEmails/{entryId} {
      allow get: if isAuthenticated() && request.auth.token.email_verified == true &&
        entryId == entryId.split('_')[0] + '_' + myEmail();
      allow list: if isAdmin() || isSchoolAdminOf(resource.data.schoolId);
      allow create, update: if (isAdmin() || isSchoolAdminOf(request.resource.data.schoolId)) &&
        request.resource.data.keys().hasOnly(['schoolId', 'email', 'addedAt']) &&
        request.resource.data.schoolId is string &&
        request.resource.data.schoolId.matches('^[A-Z0-9]{6,16}$') &&
        request.resource.data.email is string && request.resource.data.email.size() <= 200 &&
        request.resource.data.email.matches('^[a-z0-9._%+-]+@[a-z0-9-]+([.][a-z0-9-]+)*[.][a-z]{2,}$') &&
        entryId == request.resource.data.schoolId + '_' + request.resource.data.email &&
        request.resource.data.addedAt == request.time;
      allow delete: if isAdmin() || isSchoolAdminOf(resource.data.schoolId);
    }

    // Class timetables, one per school: class → day → subject per period,
    // plus bell times. Public (the classroom screen has no sign-in), so no
    // teacher names or rooms. Written by the school's admins or the founder.
    match /timetables/{schoolId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isSchoolAdminOf(schoolId)) &&
        request.resource.data.keys().hasOnly(['periods', 'grid', 'subjectMap', 'source', 'updatedAt']) &&
        request.resource.data.periods is list && request.resource.data.periods.size() <= 12 &&
        request.resource.data.grid is map && request.resource.data.grid.size() <= 300 &&
        request.resource.data.subjectMap is map && request.resource.data.subjectMap.size() <= 300 &&
        request.resource.data.source in ['asc', 'untis', 'csv', 'manual'] &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin() || isSchoolAdminOf(schoolId);
    }

    // Weeks are numbered from Monday 5 January 1970 (UTC); a count may only
    // go to the current week (one either side for clock differences).
    function currentWeek() {
      return math.floor((request.time.toMillis() - 345600000) / 604800000);
    }

    function activityPath(week) {
      return /databases/$(database)/documents/activity/$(string(week) + '_' + request.auth.uid);
    }

    // Private marker: this user was counted this week (activity/{week}_{uid}).
    // Readable only by the user; the school sees totals, never who.
    match /activity/{markerId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();

      function isValidMarker() {
        let d = request.resource.data;
        let p = get(userPath(request.auth.uid)).data;
        return d.keys().hasOnly(['userId', 'schoolId', 'week', 'bucket', 'createdAt']) &&
          d.userId == request.auth.uid &&
          d.week is int && d.week >= currentWeek() - 1 && d.week <= currentWeek() + 1 &&
          markerId == string(d.week) + '_' + request.auth.uid &&
          d.schoolId is string && d.schoolId != '' && d.schoolId == p.get('schoolId', '') &&
          // Counted where the profile says: their class, "teachers" or "other".
          d.bucket == (p.get('accountType', '') == 'teacher' ? 'teachers' :
            ((p.get('classYear', null) is int && p.get('classSection', null) is string && p.get('classSection', '') != '')
              ? string(p.classYear) + p.classSection : 'other')) &&
          d.createdAt == request.time;
      }

      allow create: if isAuthenticated() && isValidMarker();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Weekly totals per school: schoolWeeks/{schoolId}_{week}, e.g.
    // { total: 40, n_4G: 21, n_teachers: 3 }. +1 only together with creating
    // this user's marker for the week, so nobody counts twice.
    match /schoolWeeks/{weekId} {
      allow read: if isAdmin() || isSchoolAdminOf(resource.data.schoolId);

      function isVisitCount(before, changed) {
        let d = request.resource.data;
        let marker = activityPath(d.week);
        let key = 'n_' + getAfter(marker).data.bucket;
        return d.week is int && d.schoolId is string &&
          weekId == d.schoolId + '_' + string(d.week) &&
          !exists(marker) && existsAfter(marker) &&
          getAfter(marker).data.schoolId == d.schoolId &&
          getAfter(marker).data.week == d.week &&
          changed.hasOnly(['schoolId', 'week', 'total', key, 'updatedAt']) &&
          d.total == before.get('total', 0) + 1 &&
          d.get(key, 0) == before.get(key, 0) + 1 &&
          d.updatedAt == request.time;
      }

      allow create: if isAuthenticated() && isVisitCount({}, request.resource.data.keys());
      allow update: if isAuthenticated() &&
        request.resource.data.schoolId == resource.data.schoolId &&
        request.resource.data.week == resource.data.week &&
        isVisitCount(resource.data, request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if isAdmin();
    }

    // ================================================================= users

    match /users/{userId} {
      // Single profiles are public (author cards read them). Listing the whole
      // collection would expose every e-mail address, so only admins may list.
      allow get: if true;
      // School admins list the teacher sign-ups of their own school, to confirm them.
      allow list: if isAdmin() ||
        (resource.data.get('accountType', '') == 'teacher' && isSchoolAdminOf(resource.data.get('schoolId', '')));

      allow create: if isAuthenticated() &&
        userId == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        isValidUserData(request.resource.data) &&
        (request.resource.data.role == 'user' || (request.resource.data.role == 'admin' && isAdmin()));

      allow update: if
        // Own profile: anything valid except the role.
        (isAuthenticated() &&
          userId == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          isValidUserData(request.resource.data) &&
          request.resource.data.role == resource.data.role) ||
        // Admin grants or removes the teacher role, and nothing else.
        (isAdmin() &&
          userId != request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
          request.resource.data.role in ['user', 'teacher'] &&
          resource.data.role in ['user', 'teacher']) ||
        // A school admin confirms (or removes) the teachers who signed up for their school.
        (isSchoolAdminOf(resource.data.get('schoolId', '')) &&
          userId != request.auth.uid &&
          resource.data.get('accountType', '') == 'teacher' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
          request.resource.data.role in ['user', 'teacher'] &&
          resource.data.role in ['user', 'teacher']) ||
        // A teacher sign-up confirms itself with a staff address of the
        // school in the profile (see isStaffEmailOf), changing only the role.
        (isAuthenticated() &&
          userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
          resource.data.role == 'user' &&
          request.resource.data.role == 'teacher' &&
          resource.data.get('accountType', '') == 'teacher' &&
          isStaffEmailOf(resource.data.get('schoolId', '')));

      allow delete: if isAdmin();

      // Materials this user marked as studied. Private to the user.
      match /studied/{materialId} {
        allow read, delete: if isAuthenticated() && request.auth.uid == userId;
        allow create, update: if isAuthenticated() &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['createdAt']) &&
          request.resource.data.createdAt == request.time;
      }
    }

    // ============================================================== requests

    match /requests/{requestId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        isValidRequestData(request.resource.data) &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt == request.time &&
        !('acceptedUserId' in request.resource.data);

      function requestChanged() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function isRequester() {
        return isAuthenticated() && request.auth.uid == resource.data.authorId;
      }

      function answerPath(id) {
        return /databases/$(database)/documents/requests/$(requestId)/answers/$(id);
      }

      allow update: if isReportCount('r_' + requestId, resource.data.authorId) ||
        ((isAdmin() || isSchoolAdminOf(resource.data.get('schoolId', ''))) && isModKeep()) ||
        isRequester() && isValidRequestData(request.resource.data) && (
        // Close or reopen
        (requestChanged().hasOnly(['status']) &&
          ((resource.data.status == 'open' && request.resource.data.status == 'closed') ||
           (resource.data.status == 'closed' && request.resource.data.status == 'open'))) ||
        // Accept an existing answer from someone else
        (resource.data.status == 'open' &&
          request.resource.data.status == 'fulfilled' &&
          requestChanged().hasOnly(['status', 'acceptedAnswerId', 'acceptedUserId', 'acceptedUserName', 'acceptedMaterialId', 'fulfilledAt']) &&
          exists(answerPath(request.resource.data.acceptedAnswerId)) &&
          get(answerPath(request.resource.data.acceptedAnswerId)).data.userId == request.resource.data.acceptedUserId &&
          get(answerPath(request.resource.data.acceptedAnswerId)).data.materialId == request.resource.data.acceptedMaterialId &&
          request.resource.data.acceptedUserId != request.auth.uid &&
          request.resource.data.acceptedUserName is string &&
          request.resource.data.acceptedUserName.size() <= 100 &&
          request.resource.data.fulfilledAt == request.time)
      );

      // A fulfilled request is part of the helper's record, so only an admin
      // can remove it.
      allow delete: if (isRequester() && resource.data.status != 'fulfilled') || isAdmin() ||
        isSchoolAdminOf(resource.data.get('schoolId', ''));

      // One answer per user: the document id is the answering user's uid.
      match /answers/{answerId} {
        allow read: if true;

        allow create: if isAuthenticated() &&
          answerId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['userId', 'userName', 'materialId', 'materialTitle', 'createdAt']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.userName is string && request.resource.data.userName.size() <= 100 &&
          request.resource.data.materialId is string &&
          request.resource.data.materialTitle is string && request.resource.data.materialTitle.size() <= 200 &&
          request.resource.data.createdAt == request.time &&
          get(materialPath(request.resource.data.materialId)).data.authorId == request.auth.uid &&
          get(/databases/$(database)/documents/requests/$(requestId)).data.status == 'open' &&
          get(/databases/$(database)/documents/requests/$(requestId)).data.authorId != request.auth.uid;

        allow delete: if isAuthenticated() && (
          request.auth.uid == resource.data.userId ||
          request.auth.uid == get(/databases/$(database)/documents/requests/$(requestId)).data.authorId ||
          isAdmin());
      }
    }

    // =================================================== reports & moderation

    // One report per person per content: reports/{targetKey}_{uid}. Only the
    // reporter and the founder read it: the school never sees who reported.
    match /reports/{reportId} {
      function keyOf(d) {
        return d.kind == 'material' ? 'm_' + d.targetId
          : (d.kind == 'request' ? 'r_' + d.targetId : 'c_' + d.targetId + '_' + d.get('commentUserId', ''));
      }

      function targetOf(d) {
        return d.kind == 'request' ? /databases/$(database)/documents/requests/$(d.targetId)
          : (d.kind == 'material' ? materialPath(d.targetId)
            : /databases/$(database)/documents/materials/$(d.targetId)/feedback/$(d.get('commentUserId', '')));
      }

      allow get: if isAuthenticated() && (reportId.matches('.*_' + request.auth.uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['kind', 'targetId', 'commentUserId', 'targetKey', 'reason', 'note', 'reporterId', 'reporterName', 'createdAt']) &&
        request.resource.data.kind in ['material', 'comment', 'request'] &&
        request.resource.data.targetId is string && request.resource.data.targetId.size() > 0 &&
        request.resource.data.targetId.size() <= 128 &&
        (request.resource.data.kind == 'comment') == ('commentUserId' in request.resource.data) &&
        optString(request.resource.data, 'commentUserId', 128) &&
        request.resource.data.targetKey == keyOf(request.resource.data) &&
        reportId == request.resource.data.targetKey + '_' + request.auth.uid &&
        request.resource.data.reason in reportReasons() &&
        request.resource.data.note is string && request.resource.data.note.size() <= 300 &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.reporterName is string && request.resource.data.reporterName.size() <= 100 &&
        request.resource.data.createdAt == request.time &&
        getAfter(targetOf(request.resource.data)).data.get('reportCount', 0) ==
          get(targetOf(request.resource.data)).data.get('reportCount', 0) + 1 &&
        getAfter(/databases/$(database)/documents/moderation/$(request.resource.data.targetKey)).data.updatedAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // What the school's admins see for each reported content: totals per
    // reason and the notes, without names. moderation/{targetKey}.
    match /moderation/{key} {
      allow read: if isAdmin() || isSchoolAdminOf(resource.data.get('schoolId', ''));

      function schoolOfTarget(r) {
        let s = r.kind == 'request'
          ? get(/databases/$(database)/documents/requests/$(r.targetId)).data.get('schoolId', '')
          : get(materialPath(r.targetId)).data.get('schoolId', '');
        return s == null ? '' : s;
      }

      // One more report, written in the same transaction as the report.
      function isNewReport(oldCount, oldReasons, oldNotes) {
        let rp = reportPathFor(key);
        let r = getAfter(rp).data;
        let d = request.resource.data;
        let notes = d.get('notes', []);
        return isAuthenticated() &&
          !exists(rp) && existsAfter(rp) &&
          d.keys().hasOnly(['kind', 'targetId', 'commentUserId', 'schoolId', 'count', 'reasons', 'notes', 'status', 'updatedAt', 'decidedByName']) &&
          d.kind == r.kind && d.targetId == r.targetId &&
          d.get('commentUserId', '') == r.get('commentUserId', '') &&
          d.schoolId == schoolOfTarget(r) &&
          d.count == oldCount + 1 &&
          d.reasons is map &&
          d.reasons.diff(oldReasons).affectedKeys().hasOnly([r.reason]) &&
          d.reasons[r.reason] == oldReasons.get(r.reason, 0) + 1 &&
          (notes == oldNotes ||
            (r.note.size() > 0 && notes == oldNotes.concat([r.note]) && notes.size() <= 50)) &&
          d.status == 'open' &&
          d.updatedAt == request.time;
      }

      // "Va bene" (counts from zero) or "Rimuovi".
      function isDecision() {
        let d = request.resource.data;
        let changed = d.diff(resource.data).affectedKeys();
        return (isAdmin() || isSchoolAdminOf(resource.data.get('schoolId', ''))) &&
          d.updatedAt == request.time &&
          d.decidedByName is string && d.decidedByName.size() <= 100 &&
          ((d.status == 'kept' &&
              changed.hasOnly(['count', 'reasons', 'notes', 'status', 'updatedAt', 'decidedByName']) &&
              d.count == 0 && d.reasons == {} && d.get('notes', []) == []) ||
           (d.status == 'removed' && changed.hasOnly(['status', 'updatedAt', 'decidedByName'])));
      }

      allow create: if isNewReport(0, {}, []);
      allow update: if
        (resource.data.status != 'removed' &&
          request.resource.data.get('decidedByName', null) == resource.data.get('decidedByName', null) &&
          isNewReport(resource.data.count, resource.data.reasons, resource.data.get('notes', []))) ||
        isDecision();
      allow delete: if isAdmin();
    }
  }
}
